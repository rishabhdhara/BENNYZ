# ------------------------------------------------------------------
# Supabase (Frontend Public Keys — safe to expose in Vite bundle)
# ------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# Supabase (Server-Only Service Role Key — NEVER prefix with VITE_)
# Used by /api/verify-payment and /api/cod-order on Vercel
# ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Razorpay (Public Key ID for browser + Secret for /api/ routes)
# ------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
